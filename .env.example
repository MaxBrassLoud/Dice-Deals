# Supabase-Projekt (Settings > API):
SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
SUPABASE_SERVICE_KEY=DEIN_SERVICE_ROLE_KEY
# Project Settings > API > anon/public key. Erforderlich für die
# Registrierung mit Supabase-Bestätigungscode.
SUPABASE_ANON_KEY=DEIN_ANON_KEY
# Connection String (Settings > Database > Connection string pooling, "URI" fuer App-Server):
SUPABASE_DB_URL=postgresql://postgres:DEIN_PASSWORT@db.DEIN-PROJEKT.supabase.co:5432/postgres
# Discord-Login laeuft ueber Supabase Auth (Authentication > Providers > Discord).
# Der OAuth-Redirect wird dynamisch aus der Request-URL gebaut
# (<APP-URL>/api/v1/discord/callback) und muss in Authentication > URL Configuration
# als Redirect-URL eingetragen sein. In der Discord-App selbst steht als Redirect
# die Supabase-Callback-URL https://<PROJEKT>.supabase.co/auth/v1/callback.

# Secret Key fuer Flask (Sessions, CSRF, etc.)
# Fallback: os.urandom(32) – wird automatisch generiert, wenn die Variable leer ist.
# In Produktion MUSS diese Variable gesetzt sein, sonst ist der Key bei jedem Neustart anders
# und alle Sessions sind invalid.
# Erstellen: python -c "import os; print(os.urandom(32).hex())"
# oder:     openssl rand -hex 32
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_kjsdhaskjhdlkajshdlkahsdkjsdhaskjhdlkajshd